From 1f868dbd44cfdbac70f715ed69468bf3d8d69638 Mon Sep 17 00:00:00 2001
From: Junkai Mo <mowilliam416@gmail.com>
Date: Tue, 1 Sep 2026 04:58:43 +0000
Subject: [PATCH] arm64: dts: rk3588: combine NPU cores for vendor RKNPU ABI

---
 .../bindings/iommu/rockchip,iommu.yaml        | 32 +++++-
 .../bindings/npu/rockchip,rk3588-rknpu.yaml   | 97 +++++++++++++++++++
 .../dts/rockchip/rk3588-orangepi-5-plus.dts   | 46 ++++++++-
 3 files changed, 169 insertions(+), 6 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/npu/rockchip,rk3588-rknpu.yaml

diff --git a/Documentation/devicetree/bindings/iommu/rockchip,iommu.yaml b/Documentation/devicetree/bindings/iommu/rockchip,iommu.yaml
index 6ce41d1..fc61ab1 100644
--- a/Documentation/devicetree/bindings/iommu/rockchip,iommu.yaml
+++ b/Documentation/devicetree/bindings/iommu/rockchip,iommu.yaml
@@ -28,18 +28,25 @@ properties:
               - rockchip,rk3576-iommu
               - rockchip,rk3588-iommu
           - const: rockchip,rk3568-iommu
+      - items:
+          - const: rockchip,rk3588-rknpu-iommu
+          - const: rockchip,rk3588-iommu
+          - const: rockchip,rk3568-iommu
 
   reg:
+    minItems: 1
     items:
       - description: configuration registers for MMU instance 0
       - description: configuration registers for MMU instance 1
-    minItems: 1
+      - description: configuration registers for MMU instance 2
+      - description: configuration registers for MMU instance 3
 
   interrupts:
+    minItems: 1
     items:
       - description: interruption for MMU instance 0
       - description: interruption for MMU instance 1
-    minItems: 1
+      - description: interruption for MMU instance 2
 
   clocks:
     items:
@@ -72,6 +79,27 @@ required:
   - clock-names
   - "#iommu-cells"
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: rockchip,rk3588-rknpu-iommu
+    then:
+      properties:
+        reg:
+          minItems: 4
+          maxItems: 4
+        interrupts:
+          minItems: 3
+          maxItems: 3
+    else:
+      properties:
+        reg:
+          maxItems: 2
+        interrupts:
+          maxItems: 2
+
 additionalProperties: false
 
 examples:
diff --git a/Documentation/devicetree/bindings/npu/rockchip,rk3588-rknpu.yaml b/Documentation/devicetree/bindings/npu/rockchip,rk3588-rknpu.yaml
new file mode 100644
index 0000000..86b0932
--- /dev/null
+++ b/Documentation/devicetree/bindings/npu/rockchip,rk3588-rknpu.yaml
@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/npu/rockchip,rk3588-rknpu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip RK3588 combined three-core NPU
+
+maintainers:
+  - Felix Zeng <felix.zeng@rock-chips.com>
+
+description: |
+  The vendor RKNPU userspace ABI exposes the three RK3588 NPU cores through a
+  single device.  The cores share one combined Rockchip IOMMU provider so that
+  every core observes identical I/O virtual addresses.
+
+properties:
+  compatible:
+    const: rockchip,rk3588-rknpu
+
+  reg:
+    minItems: 3
+    maxItems: 3
+
+  interrupts:
+    minItems: 3
+    maxItems: 3
+
+  interrupt-names:
+    items:
+      - const: npu0_irq
+      - const: npu1_irq
+      - const: npu2_irq
+
+  clocks:
+    minItems: 8
+    maxItems: 8
+
+  clock-names:
+    items:
+      - const: clk_npu
+      - const: aclk0
+      - const: aclk1
+      - const: aclk2
+      - const: hclk0
+      - const: hclk1
+      - const: hclk2
+      - const: pclk
+
+  assigned-clocks: true
+
+  assigned-clock-rates: true
+
+  resets:
+    minItems: 6
+    maxItems: 6
+
+  reset-names:
+    items:
+      - const: srst_a0
+      - const: srst_a1
+      - const: srst_a2
+      - const: srst_h0
+      - const: srst_h1
+      - const: srst_h2
+
+  power-domains:
+    minItems: 3
+    maxItems: 3
+
+  power-domain-names:
+    items:
+      - const: npu0
+      - const: npu1
+      - const: npu2
+
+  iommus:
+    maxItems: 1
+
+  npu-supply: true
+
+  sram-supply: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - power-domains
+  - power-domain-names
+  - iommus
+
+additionalProperties: false
diff --git a/arch/arm64/boot/dts/rockchip/rk3588-orangepi-5-plus.dts b/arch/arm64/boot/dts/rockchip/rk3588-orangepi-5-plus.dts
index a39df5d..44d0b7a 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-orangepi-5-plus.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-orangepi-5-plus.dts
@@ -65,12 +65,37 @@ vbus5v0_typec: regulator-vbus-typec {
 };
 
 /*
- * The vendor-compatible RKNPU ABI is brought up on core 0 first.  Each
- * mainline RK3588 NPU core owns a separate IOMMU, so cores 1 and 2 remain
- * disabled until the driver maps every GEM object into all three domains.
+ * The vendor RKNPU ABI presents all three cores as one device and requires
+ * every core to observe the same IOVA.  Recombine the upstream per-core
+ * description here: the mainline Rockchip IOMMU driver supports multiple
+ * register banks in one provider, giving all three cores one DMA domain
+ * without relying on private IOMMU internals.
  */
 &rknn_core_0 {
-	compatible = "rockchip,rk3588-rknpu-core0";
+	compatible = "rockchip,rk3588-rknpu";
+	reg = <0x0 0xfdab0000 0x0 0x10000>,
+	      <0x0 0xfdac0000 0x0 0x10000>,
+	      <0x0 0xfdad0000 0x0 0x10000>;
+	/delete-property/ reg-names;
+	interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH 0>,
+		     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH 0>,
+		     <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH 0>;
+	interrupt-names = "npu0_irq", "npu1_irq", "npu2_irq";
+	clocks = <&scmi_clk SCMI_CLK_NPU>, <&cru ACLK_NPU0>,
+		 <&cru ACLK_NPU1>, <&cru ACLK_NPU2>,
+		 <&cru HCLK_NPU0>, <&cru HCLK_NPU1>,
+		 <&cru HCLK_NPU2>, <&cru PCLK_NPU_ROOT>;
+	clock-names = "clk_npu", "aclk0", "aclk1", "aclk2",
+		      "hclk0", "hclk1", "hclk2", "pclk";
+	resets = <&cru SRST_A_RKNN0>, <&cru SRST_A_RKNN1>,
+		 <&cru SRST_A_RKNN2>, <&cru SRST_H_RKNN0>,
+		 <&cru SRST_H_RKNN1>, <&cru SRST_H_RKNN2>;
+	reset-names = "srst_a0", "srst_a1", "srst_a2",
+		      "srst_h0", "srst_h1", "srst_h2";
+	power-domains = <&power RK3588_PD_NPUTOP>,
+			<&power RK3588_PD_NPU1>,
+			<&power RK3588_PD_NPU2>;
+	power-domain-names = "npu0", "npu1", "npu2";
 };
 
 &rknn_core_1 {
@@ -81,6 +106,19 @@ &rknn_core_2 {
 	status = "disabled";
 };
 
+&rknn_mmu_0 {
+	compatible = "rockchip,rk3588-rknpu-iommu",
+		     "rockchip,rk3588-iommu",
+		     "rockchip,rk3568-iommu";
+	reg = <0x0 0xfdab9000 0x0 0x100>,
+	      <0x0 0xfdaba000 0x0 0x100>,
+	      <0x0 0xfdaca000 0x0 0x100>,
+	      <0x0 0xfdada000 0x0 0x100>;
+	interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH 0>,
+		     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH 0>,
+		     <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH 0>;
+};
+
 &rknn_mmu_1 {
 	status = "disabled";
 };
-- 
