# Linux 7.2.2 configuration requirements for devb (Orange Pi 5 Plus).
# This fragment is merged after arm64 defconfig and the enabled options from
# the running 6.1.43 vendor kernel.

CONFIG_LOCALVERSION="-rk3588-panthor-rknpu"
# CONFIG_LOCALVERSION_AUTO is not set

# Preserve the explicitly selected devb scheduling/BPF intent.  Linux 7.2 no
# longer offers PREEMPT_NONE on arm64; PREEMPT_LAZY is its throughput-oriented
# successor on this architecture.
CONFIG_PREEMPT_LAZY=y
# CONFIG_PREEMPT is not set
# CONFIG_PREEMPT_RT is not set
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BINFMT_MISC=y

# Root-on-NVMe boot path.  Keep all of it built in.
CONFIG_PCIE_ROCKCHIP_DW_HOST=y
CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# Mainline RK3588 GPU/IOMMU.  Rocket must not claim the NPU nodes while the
# vendor-compatible RKNPU driver is used.
CONFIG_DRM=y
CONFIG_DRM_PANTHOR=m
CONFIG_DRM_ACCEL=y
CONFIG_ROCKCHIP_RKNPU=m
# CONFIG_ROCKCHIP_RKNPU_DEBUG_FS is not set
# CONFIG_ROCKCHIP_RKNPU_DEVFREQ is not set
# CONFIG_DRM_ACCEL_ROCKET is not set
CONFIG_IOMMU_SUPPORT=y
CONFIG_ROCKCHIP_IOMMU=y

# Container and binfmt support used by the running devb installation.
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_OVERLAY_FS=m
CONFIG_VETH=m
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_WIREGUARD=m

# Filesystems, virtualization and compressed swap present on devb.
CONFIG_ZRAM=y
CONFIG_BTRFS_FS=y
CONFIG_FUSE_FS=m
CONFIG_NFS_FS=y
CONFIG_KVM=y

# Preserve the user's MediaTek Wi-Fi and RNDIS selections.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=y
CONFIG_MT7921U=m
# USB_NET_RNDIS_WLAN was removed; the generic mainline RNDIS host covers the
# same USB networking transport in Linux 7.2.
CONFIG_USB_NET_RNDIS_HOST=y

# Orange Pi 5 Plus Ethernet PHY.
CONFIG_MOTORCOMM_PHY=y
